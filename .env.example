# Copy to .env and add your own key. Never commit .env.
GOOGLE_API_KEY=
LLM_PROVIDER=google
LLM_MODEL=gemini-2.5-flash
OLLAMA_BASE_URL=http://localhost:11434
DATABASE_PATH=banking_demo.sqlite3

# Explicit demo policy: change or blank this to require a customer-specific rate.
DEMO_INTEREST_RATE=12.5
MAX_FOIR_PERCENT=40

# This identity is synthetic and can only be used after clicking Authenticate demo user.
DEMO_CUSTOMER_ID=demo-customer-001